[Unit]
Description=fordDbs: back up databases, photos and secrets to the NAS (#31)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=dad
WorkingDirectory=/home/dad/docker/fordDbs
ExecStart=/usr/bin/python3 -m ops.backup.backup
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
