# Settings for the NAS backups (#31).
# Copy to ~/.config/fordDbs-backup/env on the Pi and chmod 600.
# Never commit the real file.

# Folder on the NAS share (its parent must be the SMB mount).
BACKUP_ROOT=/mnt/nas/alan/fordDbs-backups

# ntfy topic URL: long and random, it is the only secret protecting it.
NTFY_URL=https://ntfy.sh/replace-with-a-long-random-topic

# Public key from `age-keygen` on the Mac (starts with age1...).
# The private key stays in the password manager, never on the Pi.
AGE_RECIPIENT=age1replace-with-your-public-key

# Read-only MinIO user for the photo copy.
BACKUP_READER_KEY=backup-reader
BACKUP_READER_SECRET=replace-with-the-reader-secret

# Optional overrides (defaults shown).
# MINIO_URL=http://localhost:9000
# POSTGRES_SOURCE=/home/dad/docker/postgres-backups/backups
# DOCKER_ROOT=/home/dad/docker
# LOCK_PATH=/home/dad/.cache/fordDbs-backup.lock
